# ==========================================================================
#  BALIWISE - Contoh environment variable
#  Salin file ini menjadi ".env" lalu isi nilainya.
#  JANGAN pernah commit file .env ke GitHub!
# ==========================================================================

# Kunci API Google Gemini (wajib).
# Cara mendapatkannya:
#   1. Buka https://aistudio.google.com/apikey
#   2. Klik "Create API key"
#   3. Salin kuncinya ke baris di bawah
AI_API_KEY=ganti_dengan_api_key_google_gemini_anda

# ---------------------------------------------------------------------------
# Model Gemini (opsional - punya nilai bawaan di kode)
# ---------------------------------------------------------------------------
# Model utama. Default: gemini-3.8-flash (model stabil terkini).
# WAJIB bukan "gemini-3.8-flash" - model itu sudah dihapus Google (shut down)
# sehingga permintaan ke model tersebut dibalas HTTP 404.
AI_MODEL=gemini-3.8-flash

# Model cadangan, dipakai otomatis bila model utama 404 / ditolak.
# Default: gemini-2.5-flash
# CATATAN: Google membatasi akses API ke model 2.5 hanya untuk pengguna lama.
# Untuk akun baru,gm-safe pilih: gemini-3.6-flash
AI_MODEL_FALLBACK=gemini-2.5-flash

# Model cadangan kedua (jaring pengaman terakhir).
# Default: gemini-3.6-flash
AI_MODEL_DARURAT=gemini-3.6-flash

# ---------------------------------------------------------------------------
# Batas waktu AI (opsional - ada nilai bawaan di kode)
# ---------------------------------------------------------------------------
# Batas per percobaan. Percobaan pertama dibatasi lebih pendek supaya model
# lambat tidak menahan traveler lebih dari perlu.
# AI_TIMEOUT_PERTAMA_MS=16000
# AI_TIMEOUT_MS=27000
#
# Anggaran waktu TOTAL satu permintaan (semua model + semua variasi).
# Setelah batas ini habis, server TIDAK error: rencana dari kode
# (lib/rencana.js) yang dikirim, dengan narasiAI=false.
# JANGAN lebih besar dari maxDuration di vercel.json (60 detik).
# AI_TOTAL_BUDGET_MS=45000

# Port server pengembangan lokal (opsional, default 3000)
PORT=3000

# Aktifkan mode mock (tanpa memakai kuota API, untuk menguji tampilan saja).
# Windows PowerShell: $env:MOCK_AI="1"; node tools/dev-server.js
# MOCK_AI=1
